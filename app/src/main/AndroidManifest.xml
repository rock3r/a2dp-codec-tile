<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="dev.sebastiano.a2dpcodec">
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <application android:label="A2DP Codec Tile">
        <activity
            android:name=".CodecPickerActivity"
            android:exported="true"
            android:theme="@style/Theme.CodecPicker"
            android:label="Choose A2DP codec">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE_PREFERENCES" />
            </intent-filter>
        </activity>
        <service
            android:name=".CodecResetTile"
            android:exported="true"
            android:icon="@drawable/ic_codec_hd"
            android:label="A2DP codec"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
    </application>
</manifest>
